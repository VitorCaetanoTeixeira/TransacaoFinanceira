{
	"version": "2.0.0",
	"tasks": [
	  {
		"label": "build",
		"command": "dotnet",
		"type": "process",
		"args": [
		  "build",
		  "${workspaceFolder}/TransacaoFinaceira.csproj",
		  "--nologo",
		  "--verbosity",
		  "normal"
		],
		"problemMatcher": "$msCompile",
		"group": "build",
		"presentation": {
		  "echo": true,
		  "reveal": "always",
		  "focus": false,
		  "panel": "shared"
		}
	  },
	  {
		"label": "clean",
		"command": "dotnet",
		"type": "process",
		"args": [
		  "clean",
		  "${workspaceFolder}/TransacaoFinaceira.csproj"
		],
		"problemMatcher": "$msCompile"
	  }
	]
  }